{
  "code": {
    "root": "../..",
    "exclude": ["attachments/*", ".grok/*", "public/__grok/*", "server/*", "scripts/grok-pwa*", "*package-lock.json", "engine/cards/*", "*-FROM-DB.md"]
  },
  "chats": ["../../attachments/*.md"],
  "pm_dir": "..",
  "promote": {"cluster": "C", "layer": 1, "type": "fact", "mcp_apply": false, "max_waiting": 20, "warn_ratio": 0.8},
  "canon_types": ["fact", "decision"],
  "handoff_note": "HANDOFF.md",
  "handoff_note_max_tok": 700,
  "handoff_ledger_max_lines": 40,
  "handoff_ledger_line_chars": 240,
  "notes": {"mcp_write": true, "require_sources": true},
  "lint": {"churn_versions": 5, "derived_raw_warn": 0.6, "derived_raw_min_tok": 10000}
}
